generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("operator") // "admin" | "operator"
  createdAt    DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  order    Int       @default(0)
  products Product[]
}

model Product {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  tagline    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  heightCm       Int
  springType     String
  comfortLayer   String
  firmness       String
  firmnessPct    Int
  fabric         String
  cooling        Boolean @default(false)
  hypoallergenic Boolean @default(true)
  warrantyYears  Int     @default(5)
  trialDays      Int     @default(30)
  deliveryNote   String  @default("Pulsuz, yatağa qədər")

  image            String
  specLine         String
  shortDescription String
  description      String
  whoFor           String  @default("[]") // JSON array
  whoNot           String?
  layers           String? // JSON array of {title,text}

  // Placement / status
  active         Boolean @default(true)
  popular        Boolean @default(false)
  showOnHome     Boolean @default(false)
  showInCompare  Boolean @default(true)
  includeInHotel Boolean @default(true)
  order          Int     @default(0)

  // Custom size
  customSizeAllowed Boolean @default(true)
  depositPct        Int     @default(30)
  customReturnable  Boolean @default(false)

  sizes     Size[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Size {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label         String
  price         Int
  discountPrice Int?
  stock         String  @default("Sifarişlə")
  leadTime      String  @default("2 gün")
  active        Boolean @default(true)
  isDefault     Boolean @default(false)
  order         Int     @default(0)
}

model Review {
  id        String   @id @default(cuid())
  author    String
  model     String
  stars     Int      @default(5)
  text      String
  status    String   @default("published") // published | pending
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  id   Int    @id @default(1)
  data String // JSON blob of site-wide settings
}

model ChangeLog {
  id        String   @id @default(cuid())
  productId String?
  message   String
  author    String   @default("Admin")
  createdAt DateTime @default(now())
}

// B2B saytının form sorğuları (Quote / OEM enquiry)
model Lead {
  id           String   @id @default(cuid())
  type         String // "quote" | "oem"
  path         String? // seçilmiş yol (quote) və ya "OEM"
  name         String
  company      String?
  email        String?
  phone        String?
  country      String?
  businessType String?
  comments     String?
  data         String   @default("{}") // dinamik sahələr JSON
  fileName     String?
  status       String   @default("new") // new | contacted | closed
  createdAt    DateTime @default(now())
}
